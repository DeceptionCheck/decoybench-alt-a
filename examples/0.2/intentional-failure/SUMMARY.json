    "abnormal_finish": [
      "A finish reason other than 'stop' (for example a content filter).",
      "Read the finish reason column."
    ],
    "deadline_exceeded": [
      "No complete response within the deadline (a stall or a slow trickle).",
      "Look at stage and first-content time to see where time went. Do not raise the deadline to hide it."
    ],
    "empty_final": [
      "A complete response with no visible answer.",
      "Check reasoning-only replies or an empty generation."
    ],
    "http_error": [
      "The model endpoint answered with a non-200 status other than 429.",
      "Check the endpoint path, the model name and the credential. Error bodies are not stored."
    ],
    "internal_error": [
      "The harness itself raised an error for this attempt.",
      "This is a DecoyBench defect. Report it with the row."
    ],
    "malformed_envelope": [
      "The response could not be parsed (invalid HTTP status line, invalid JSON or event).",
      "Check that the endpoint speaks the expected contract; use --no-stream for JSON-only servers."
    ],
    "missing_finish": [
      "A complete stream with no finish reason.",
      "The endpoint does not follow the contract; record it."
    ],
    "ok": [
      "Complete, usable response inside the deadline.",
      "Nothing to do."
    ],
    "partial_body": [
      "The connection ended before the response was complete (no stream terminator or short body).",
      "Check the server or proxy for early closes and response size limits."
    ],
    "setup_timeout": [
      "DNS, TCP connect and TLS did not finish within the setup cap.",
      "Check that the service is listening and has enough accept capacity (listen backlog) for the client count. On the built-in fixture this should never happen; report it."
    ],
    "status_mismatch": [
      "A complete response with a different status than the case expects.",
      "Check the case expectation and the service's route; a changed status is a behaviour change."
    ],
    "throttled_429": [
      "The endpoint answered HTTP 429 (rate limited). It stays in the denominator and is not a fast success.",
      "Lower the client count or the rate, or ask the endpoint owner for a higher limit. Do not add retries to hide it."
    ],
    "too_large": [
      "The response exceeded the size limit and was abandoned.",
      "Check the endpoint; raise the limit only deliberately."
    ],
    "tool_call": [
      "The model returned a tool call instead of an answer.",
      "This harness sends no tools; a tool call is a failure."
    ],
    "transport_error": [
      "The connection was refused or reset before a response.",
      "Check that the service is up and reachable."
    ],
    "truncated_final": [
      "The model stopped because of a length limit (finish reason 'length').",
      "Raise --max-tokens only if the use case allows longer replies; a truncated answer is not a success."
    ]
